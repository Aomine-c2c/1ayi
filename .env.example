# AYIS — Environment template
# Copy to .env and edit. NEVER commit real .env.

# ---- Database (PostgreSQL / PostGIS) ----
DB_PASSWORD=ayis-dev-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ayis
DB_USER=ayis
DB_ENGINE=django.contrib.gis.db.backends.postgis

# ---- Redis / Valkey ----
REDIS_URL=redis://localhost:6379/0

# ---- Django ----
SECRET_KEY=replace-with-a-real-secret-in-every-environment
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGIN_WHITELIST=http://localhost:3000,http://localhost:1420,tauri

# ---- JWT (SimpleJWT) ----
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- Frontend API ----
API_BASE_URL=http://localhost:8000/api/v1

# ---- Celery ----
CELERY_TASK_ALWAYS_EAGER=false

# ---- External services (Level 2+) ----
WEATHER_SOURCE=open-meteo
